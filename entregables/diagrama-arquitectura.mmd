flowchart LR
  subgraph Usuarios["Usuarios y navegador"]
    C["Cliente<br/>Catálogo, disponibilidad<br/>Reserva y Mis reservas"]
    A["Administrador<br/>Panel de gestión"]
  end

  subgraph VM["Máquina virtual Azure del equipo<br/>Nombre del recurso / configuración por confirmar"]
    Static["Express sirve páginas<br/>HTML · CSS · JavaScript"]
    API["API Node.js + Express<br/>Rutas · controladores"]
    Authz["Middleware<br/>Verificación de token<br/>Permiso de administrador"]
    Rules["Servicios y modelos<br/>Validación · disponibilidad<br/>Estados de reserva"]
    Repo["Repositorios<br/>Firebase Admin SDK"]
  end

  FirebaseAuth["Firebase Authentication"]
  Firestore["Cloud Firestore<br/>cabanas · imagenUrl HTTPS<br/>reservas · nochesOcupadas"]
  ImageHost["Sitio externo de imágenes<br/>URLs HTTPS públicas"]

  C <-->|GET páginas / respuesta| Static
  A <-->|GET panel / respuesta| Static
  C -->|"Registro / inicio de sesión"| FirebaseAuth
  A -->|"Inicio de sesión"| FirebaseAuth
  FirebaseAuth -->|"ID token"| C
  FirebaseAuth -->|"ID token"| A
  C <-->|Catálogo público; Bearer en reserva y Mis reservas| API
  A <-->|Bearer token: gestión administrativa y URL de imagen| API
  API --> Authz --> Rules --> Repo
  Repo <-->|"Lecturas y escrituras"| Firestore
  C -->|"GET de la imagen"| ImageHost
  A -->|"Vista previa de la imagen"| ImageHost

