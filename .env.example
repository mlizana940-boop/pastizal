PORT=3000
FIREBASE_PROJECT_ID=tu-id-de-proyecto
# En desarrollo, usa GOOGLE_APPLICATION_CREDENTIALS apuntando a un archivo fuera del repositorio,
# o guarda el JSON de la cuenta de servicio en esta variable local ignorada por Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
# UID(s) de Firebase Authentication autorizados para administrar, separados por coma.
FIREBASE_ADMIN_UIDS=